{
	"name": "@567agent/remote-desktop",
	"version": "0.0.1",
	"description": "WebRTC screen and remote input contracts for 567 Agent",
	"author": "567wiki <907746241@qq.com>",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./protocol": {
			"types": "./dist/protocol-entry.d.ts",
			"import": "./dist/protocol-entry.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "bun ../../scripts/quality/run-vitest.mjs --run --config vitest.config.ts",
		"test:e2e": "bun run build && electron scripts/webrtc-e2e-main.cjs"
	},
	"devDependencies": {
		"electron": "^34.2.0",
		"typescript": "^5.9.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Chinachani/567-agent.git",
		"directory": "packages/remote-desktop"
	}
}
