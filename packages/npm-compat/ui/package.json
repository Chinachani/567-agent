	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"import": "./dist/utils.js"
		}
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Chinachani/567-agent.git",
		"directory": "packages/npm-compat/ui"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "node ../../../scripts/generate-npm-compat.mjs ui",
		"prepack": "node ../../../scripts/generate-npm-compat.mjs ui"
	},
