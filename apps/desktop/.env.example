# 567 Agent — environment variable index
#
# Full guide: docs/desktop/build-modes.md  ·  English: docs/desktop/build-modes.en.md
#
# Copy this file to .env.development and uncomment what you need.
# No .env.* file is tracked in git.
#
# Precedence: inline on the command line > process env > .env.<mode> > .env > code defaults.
# Packaging: AGENT567_BUILD_ENV=<mode> selects which .env.<mode> to load.
# Application-owned configuration uses AGENT567_* and API567_* names. Integrations such as
# Langfuse may also require their documented upstream environment variables.
#
# Every line below is commented out on purpose: development still works without
# configuration. Packaging requires an explicit edition; use `bun run
# dist:opensource` for the supported open-source defaults.
#
# !! Secrets (certificates, private keys, auth tokens, cloud credentials) never
#    belong in a .env file. See the "Secrets" section of the guide.


# ─── Build mode ──────────────────────────────────────────────────────────────
# "false" => open-source / serv-less. Cloud code is not bundled at all.
# "true"  => commercial build with cloud services enabled.
# Packaging rejects an unset or misspelled value.
# Build-time only: cannot be re-enabled at runtime after shipping.
# AGENT567_CLOUD_ENABLED=true

# Server API endpoint. Required for commercial builds, forbidden in open-source builds.
# API567_BASE_URL=https://api.example.com/api/v1



# ─── Ability marketplace ────────────────────────────────────────────────────
# GitHub sources are independent of cloud services in every build mode.
# Both editions register the built-in 567 Agent official source; users cannot disable or remove it.
# Set AGENT567_OPEN_MARKETPLACE_REPOSITORY only to replace that built-in source with your own fork.
# Users can still add extra sources in Abilities.
# Restart development processes after changing build environment values.
# AGENT567_OPEN_MARKETPLACE_REPOSITORY=https://github.com/Chinachani/567-agent-marketplace
# AGENT567_OPEN_MARKETPLACE_REF=main
# Optional: normally omit this so the archive URL follows the repository and ref above.
# AGENT567_OPEN_MARKETPLACE_ARCHIVE_URL=https://github.com/Chinachani/567-agent-marketplace/archive/refs/heads/main.zip


# ─── Build-time trimming ─────────────────────────────────────────────────────
# Windows local speech input. Enabled unless set to "false", which drops the
# speech models, the Sherpa native runtime and the speech entry point.
# AGENT567_SPEECH_INPUT_ENABLED=false

# System-plugin tenant; decides which presets get packaged.
# Values live in packages/plugins/tenants.json. Set automatically by dev/pack
# scripts, so you rarely want it here.
# AGENT567_TENANT=common


# ─── Development toggles ─────────────────────────────────────────────────────
# Reveal the "UI theme" section in appearance settings (default / xianxia).
# AGENT567_SHOW_UI_THEME=true

# Development only: skip approval dialogs for local actions while iterating locally.
# The dev Electron launcher defaults this to 1; set it to 0 to test the approval flow.
# AGENT567_DEV_AUTO_APPROVE_ACTIONS=1


# ─── Auto-update ─────────────────────────────────────────────────────────────
# generic | github. Commercial builds use generic; open-source builds use github.
# AGENT567_UPDATE_PROVIDER=generic

# For "generic": R2, self-hosted object storage, or any static HTTP/CDN root.
# Defaults to the official stable feed when omitted from a commercial build.
# AGENT567_UPDATE_URL=https://releases.example.com/desktop/stable

# For "github".
# AGENT567_UPDATE_GITHUB_OWNER=owner
# AGENT567_UPDATE_GITHUB_REPO=repository

# R2 upload target, used only by publish:updates:r2 (credentials are secrets).
# AGENT567_R2_BUCKET=567-agent-releases
# AGENT567_R2_PREFIX=desktop/stable


# ─── Observability: Sentry ───────────────────────────────────────────────────
# No-op when the DSN is unset. The DSN ends up in the bundle.
# AGENT567_SENTRY_DSN=https://public-key@your-sentry.example.com/project-id

# Immutable release; must match exactly between runtime and source-map upload.
# AGENT567_SENTRY_RELEASE=567-agent-desktop@0.0.0+local
# AGENT567_TELEMETRY_ENVIRONMENT=development
# AGENT567_SENTRY_TRACES_SAMPLE_RATE=0

# Source-map upload (CI only). AGENT567_SENTRY_URL is for self-hosted Sentry only.
# AGENT567_SENTRY_ORG=your-org-slug
# AGENT567_SENTRY_PROJECT=your-project-slug
# AGENT567_SENTRY_URL=https://sentry.example.com

# Emit a main-process source map locally without uploading anything.
# AGENT567_MAIN_SOURCEMAP=true


# ─── Observability: PostHog ──────────────────────────────────────────────────
# Project API Key (phc_...), NOT a Personal API Key. Ends up in the renderer bundle.
# AGENT567_POSTHOG_KEY=phc_xxx
# AGENT567_POSTHOG_HOST=https://us.i.posthog.com
# AGENT567_POSTHOG_REPLAY_ENABLED=false
# AGENT567_POSTHOG_REPLAY_SAMPLE_RATE=0.05


# ─── Observability: Langfuse ─────────────────────────────────────────────────
# Opt-in end-to-end tracing of agent / LLM / tool calls.
# AGENT567_TRACING=langfuse
# AGENT567_TRACING_TRACE_NAME="567 Agent"
# LANGFUSE_PUBLIC_KEY="pk-lf-xx"
# LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=local
# OTEL_SERVICE_NAME=567-agent
